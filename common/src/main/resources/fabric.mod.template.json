{
  "schemaVersion": 1,
  "id": "ffcraft",
  "version": "${mod_version}",
  "name": "${archives_base_name}",
  "description": "${mod_description}",
  "authors": ${mod_authors},
  "contact": ${mod_contact},
  "license": "${mod_license}",
  "icon": "assets/ffcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "sashwind.mc.mod.ffcraft.client.FFCraftDataGenerator"
    ],
    "client": [
      "sashwind.mc.mod.ffcraft.client.FFCraftClient"
    ],
    "main": [
      "sashwind.mc.mod.ffcraft.FFCraft"
    ]
  },
  "mixins": [
    "ffcraft.mixins.json",
    {
      "config": "ffcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "drawlib": "*"
  }
}
